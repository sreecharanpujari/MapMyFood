# ==========================================
# Map My Food - Environment Configuration
# ==========================================

# Application Environment (development | production | staging)
ENVIRONMENT=development

# Database Connection URL
# Local development default: SQLite
DATABASE_URL=sqlite:///./map_my_food.db

# Production example (PostgreSQL free tier on Neon / Supabase):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/map_my_food?sslmode=require

# JWT Authentication Secret Key
# Generate a secure 32+ character key for production: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY=map-my-food-dev-secret-key-change-in-production-2026

# JWT Token Expiration in Minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated without trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

